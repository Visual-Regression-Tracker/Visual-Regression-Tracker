## Logging
# https://www.elastic.co/guide/en/elastic-stack/7.14/overview.html
ELK_VERSION=7.14.1
ELASTIC_URL=http://localhost:9200

## VRT version
VRT_UI_VERSION=6.0.0-rc6
VRT_API_VERSION=6.0.0-rc6
VRT_MIGRATION_VERSION=6.0.0-rc6
# only with the dinov2 profile, see DINOV2_URL
VRT_DINOV2_VERSION=1.0.0-rc2

## Frontend

# direct URL to backend with port (same as APP_PORT)
REACT_APP_API_URL=http://localhost:4200
# frontend port
PORT=8080
# with OIDC enabled, 'true' sends the login page straight to the identity provider
# instead of showing the "Login with SSO" button
#REACT_APP_OIDC_AUTO_REDIRECT=true

## Backend

# direct URL to frontend with port (same as PORT)
APP_FRONTEND_URL=http://localhost:8080
# backend port
APP_PORT=4200

# Uncomment and update below section, if you want to use AWS image storage
#STATIC_SERVICE=s3
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_REGION=
#AWS_S3_BUCKET_NAME=

# Uncomment and update below section, if you want to use LDAP
#LDAP_ENABLED=true
#LDAP_TLS_NO_VERIFY=false
#LDAP_URL='ldaps://ldap.example.com:636/'
#LDAP_BIND_USER='CN=searchuser,OU=systemaccounts,DC=example,DC=com'
#LDAP_BIND_PASSWORD='searchuserpassword'
#LDAP_SEARCH_DN='OU=users,DC=example,DC=com'
#LDAP_USERS_SEARCH_FILTER='(&(objectClass=Person)(objectCategory=Person)(|(mail={{email}})(sAMAccountName={{email}})))'
#LDAP_ATTRIBUTE_LAST_NAME='sn'
#LDAP_ATTRIBUTE_FIRST_NAME='givenName'
#LDAP_ATTRIBUTE_MAIL='mail'  

# Uncomment and update below section, if you want to use SSO login via OpenID Connect (OIDC)
# Takes precedence over LDAP. Password login and registration are disabled while it is on;
# users are created on their first login. Register OIDC_REDIRECT_URI as a redirect URI of
# the client at your identity provider (Keycloak, Entra ID, Okta, Google, ...).
#OIDC_ENABLED=true
#OIDC_ISSUER_URL='https://idp.example.com/realms/example'
#OIDC_CLIENT_ID='vrt-client'
#OIDC_CLIENT_SECRET='clientsecret'
#OIDC_REDIRECT_URI='http://localhost:4200/users/oidc/callback'
#OIDC_SCOPES='openid profile email'
#OIDC_ATTRIBUTE_MAIL='email'
#OIDC_ATTRIBUTE_FIRST_NAME='given_name'
#OIDC_ATTRIBUTE_LAST_NAME='family_name'
# claim name or dotted path into nested claims, e.g. 'realm_access.roles' for Keycloak realm roles
#OIDC_ROLE_CLAIM='groups'
# a value from this list in the role claim makes the user an admin, otherwise OIDC_DEFAULT_ROLE;
# the role is updated from the identity provider on every login
#OIDC_ADMIN_VALUES='vrt-admin,admin'
#OIDC_DEFAULT_ROLE='editor'
# reject email addresses the identity provider does not mark as verified
#OIDC_REQUIRE_VERIFIED_EMAIL=true
# skip TLS certificate verification for the issuer only (self-signed identity providers)
#OIDC_TLS_NO_VERIFY=false

# Ollama for VLM image comparison
OLLAMA_BASE_URL=http://host.docker.internal:11434

# key that signs login tokens, required: generate one with `openssl rand -hex 32`
JWT_SECRET=
# user session lifetime
JWT_LIFE_TIME=1d
# max JSON body, i.e. a base64 screenshot upload
BODY_PARSER_JSON_LIMIT="5mb"
# max multipart screenshot upload in bytes (default 100 MB)
#MULTIPART_FILE_SIZE_LIMIT=104857600
# screenshots above this many pixels are refused (default 100000000)
#MAX_IMAGE_PIXELS=100000000
# 'false' hides sign-up; users are then created by an admin, LDAP or OIDC
#REGISTRATION_ENABLED=true
# comma-separated Nest log levels, e.g. 'log,error,warn'
#LOG_LEVEL=

# Live updates (socket.io). The defaults need UI 6.0.0; while a UI 5.x is still open:
# 'false' lets in sockets without a login token
#WS_AUTH_REQUIRED=true
# 'true' sends every event to every client, not only to those viewing that project or build
#WS_BROADCAST=false
# only for more than one API instance (needs a Redis service): share socket events
#REDIS_URL=redis://redis:6379

# DINOv2 service: second stage of the rendering-noise check; the blur stage works without it.
# `docker compose --profile dinov2 up -d` and uncomment
#DINOV2_URL=http://dinov2:8000
#DINOV2_TIMEOUT_MS=
# the service refuses larger screenshots (413) and more than this many waiting requests (503);
# the check then reports the DINOv2 stage as unavailable. Defaults fit the 2g memory limit.
#DINOV2_MAX_PIXELS=20000000
#DINOV2_MAX_QUEUE=2
#DINOV2_MEM_LIMIT=2g

## DB

POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vrt_db

DEFAULT_USER_EMAIL=visual-regression-tracker@example.com
DEFAULT_USER_PASSWORD=123456
DEFAULT_USER_API_KEY=DEFAULTUSERAPIKEYTOBECHANGED
